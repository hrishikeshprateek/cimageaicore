# ---- CIMAGE AI Media Platform : environment ----
# Copy to .env and fill in. Never commit .env.

# auto = use gemini when GEMINI_API_KEY is set, otherwise mock
AI_PROVIDER=auto

# Gemini API. Create an *authorization key* in Google AI Studio inside a dedicated project.
GEMINI_API_KEY=
# gemini-3.5-flash-lite: benchmarked 29s vs 378s for gemini-3.8-flash on a 73s clip, same input tokens, comparable blocks
GEMINI_MODEL=gemini-3.5-flash-lite
# low | medium | high
GEMINI_THINKING_LEVEL=low
# blank = model default
GEMINI_MAX_OUTPUT_TOKENS=
# low | medium | high | ultra_high
GEMINI_VIDEO_RESOLUTION=medium
# delete the File API upload after analysis
GEMINI_DELETE_UPLOADS=true
# do not retain request/response on Google's side
GEMINI_STORE=false
# analysis call / per upload chunk / status polls
GEMINI_TIMEOUT_SECONDS=1800
GEMINI_UPLOAD_TIMEOUT_SECONDS=600
GEMINI_POLL_TIMEOUT_SECONDS=30

# Embeddings for semantic search (V0.3). auto = gemini when a key is set, else mock.
# auto = gemini when GEMINI_API_KEY is set, else mock.  ollama = local EmbeddingGemma (no API cost, works offline):
#   brew install ollama / apt: curl -fsSL https://ollama.com/install.sh | sh  ->  ollama pull embeddinggemma
# Switching providers re-embeds every block on the next run of scripts/embed_backfill.py (vectors of two models never mix).
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=auto            # auto -> gemini-embedding-2 | embeddinggemma | mock-embed-v1 per provider
EMBEDDING_DIMENSIONS=768        # both real models are 768-d; matches database/migrations/003_embeddings.sql
OLLAMA_URL=http://localhost:11434

# Where the app keeps uploads, job records and analysis JSON
DATA_DIR=./data

# Only paths under these roots may be analysed by path (the NAS mount goes here later). Comma separated.
NAS_ALLOWED_ROOTS=./data/nas-test

# Seconds a NAS file's size/mtime must stay unchanged before it is considered fully copied
STABLE_SECONDS=2

MAX_UPLOAD_MB=2048
WORKER_THREADS=2

# prompts/video-analysis/<version>.md ; keep old versions for A/B comparison
PROMPT_VERSION=v2
# focused second call that identifies people against prompts/known_people.txt (blank = off)
PEOPLE_PASS_VERSION=people_v1

# Blog Agent (V0.5). BLOG_MODEL blank = same as GEMINI_MODEL; gemini-3.8-flash writes better prose (5 RPM / 20 RPD free).
BLOG_PROMPT_VERSION=blog_v2   # v2 = depth modes + pictures (video frames / local library); v1 kept for comparison
BLOG_MODEL=
BLOG_THINKING_LEVEL=medium
INSTITUTION_CONTEXT=CIMAGE Group of Institutions, Patna, Bihar, India - a college offering BBA, BCA, MBA/PGDM and related programmes.

# PostgreSQL (docker compose maps the container to host port 5433). Leave blank to fall back to JSON-file storage.
DATABASE_URL=postgresql://cimage:cimage@localhost:5433/cimage_ai
AUTO_MIGRATE=true
# Redis (host port 6380) - used from V0.4
REDIS_URL=redis://localhost:6380/0

# ---- Video Composer (services/video_composer) ----
COMPOSER_ENABLED=false
# data/composer/templates/<name>/template.json ; "placeholder" is generated. Upload real layers via the composer UI to create e.g. "cimage".
COMPOSER_TEMPLATE=placeholder
# blank = <DATA_DIR>/composer/templates and <DATA_DIR>/renders (the Docker data volume)
COMPOSER_TEMPLATES_DIR=
COMPOSER_RENDERS_DIR=
# brand fonts (blank = bundled Poppins + Noto Sans Devanagari fallback)
COMPOSER_FONT_REGULAR=
COMPOSER_FONT_BOLD=
# x264 preset/quality; ultrafast for quick previews, medium for delivery
COMPOSER_X264_PRESET=medium
COMPOSER_CRF=20
COMPOSER_FPS=30
# overlay (PNG captions, works on any ffmpeg) | libass (needs ffmpeg built with libass)
COMPOSER_CAPTION_ENGINE=overlay
# cut proposals: length limits in seconds and whether Gemini refines them (off | auto)
COMPOSER_MIN_CUT_SECONDS=8
COMPOSER_MAX_CUT_SECONDS=60
COMPOSER_TARGET_CUT_SECONDS=30
COMPOSER_MAX_CUTS=3
COMPOSER_CUTS_REFINE=off
COMPOSER_WORKER_THREADS=1

# ---- folder watcher (V0.4): the platform picks up videos on its own --------------------------------
# Polls the folders every WATCHER_INTERVAL_SECONDS; a file is taken once its size/mtime stayed the same for
# WATCHER_STABLE_SECONDS (copy finished); same bytes under two names = one job; at most WATCHER_MAX_ACTIVE_JOBS
# analyses run at once. Progress + controls: /admin -> Folder watcher.
WATCHER_ENABLED=false
WATCH_ROOTS=./data/nas-test/AI-Test      # comma-separated; automatically allowed for /analyze too
WATCHER_INTERVAL_SECONDS=30
WATCHER_STABLE_SECONDS=10
WATCHER_MAX_ACTIVE_JOBS=2
# docker compose only: the host folder that is mounted read-only at /nas inside the container AND scanned by the watcher,
# e.g. the NAS drop folder: NAS_WATCH_DIR="/mnt/nas/Cimage AI Agent"  (quote paths with spaces)
NAS_WATCH_DIR=./data/nas-test/AI-Test

# ---- auto-draft (V0.6): finished video -> blog draft waiting in /admin -> Review, unasked --------------
AUTO_DRAFT=false
AUTO_DRAFT_MAX_PER_VIDEO=1               # best opportunities per video to draft (by confidence)
AUTO_DRAFT_MIN_CONFIDENCE=0.5
AUTO_DRAFT_DEPTH=standard                # standard (~1000 words) | in_depth (~1500)

# ---- upload proxies: shrink raw camera files before Gemini ------------------------------------------
# Gemini charges per second of video (~1 fps sampled), not per byte, and refuses files over 2 GB. Sources at or
# above PROXY_MIN_MB (or above PROXY_MAX_BITRATE_KBPS) are transcoded to PROXY_MAX_HEIGHT H.264 first; the
# original stays on the NAS for reels. Proxies live in data/proxies and are deleted after analysis unless PROXY_KEEP=true.
PROXY_ENABLED=true
PROXY_MIN_MB=400
PROXY_MAX_HEIGHT=720
PROXY_MAX_BITRATE_KBPS=6000
PROXY_CRF=28
PROXY_KEEP=false

# ---- Publishing (V1.0) ----
# Encrypts WordPress application passwords at rest. Blank = a key is generated once into DATA_DIR/.secret_key.
# Set it explicitly in production so a restored database can still decrypt its targets: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PUBLISH_SECRET_KEY=
